{
  "name": "devcontainer-claude-code",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "progress": "plain"
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    // Required by init-firewall.sh to manage iptables/ipset. Harmless no-op when
    // INIT_FIREWALL=false.
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // Chromium (Playwright MCP) crashes with the default 64MB /dev/shm.
    "--shm-size=1g"
  ],
  // Persist Claude Code session/auth state and shell history across rebuilds.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
  ],
  // Set INIT_FIREWALL=true on the host to enable the egress firewall. Defaults to false.
  "containerEnv": {
    "INIT_FIREWALL": "${localEnv:INIT_FIREWALL:false}"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "latest",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh ${containerWorkspaceFolder}",
  // The script and its allowlist are baked into the image (see Dockerfile), so this always
  // runs our version — never the feature-provided init-firewall.sh — and workspace edits
  // only take effect after a rebuild. INIT_FIREWALL gates execution only.
  "postStartCommand": "if [ \"$INIT_FIREWALL\" = true ]; then sudo /usr/local/bin/devcontainer-init-firewall.sh; else echo 'INIT_FIREWALL=false: skipping egress firewall setup'; fi",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "wenbopan.vscode-terminal-osc-notifier"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "security.workspace.trust.enabled": false
      }
    }
  }
}