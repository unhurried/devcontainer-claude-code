{
  "name": "devcontainer-claude-code",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "progress": "plain"
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    // Needed by init-firewall.sh for iptables/ipset; harmless when INIT_FIREWALL=false.
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // Chromium (Playwright MCP) crashes with the default 64MB /dev/shm.
    "--shm-size=1g"
  ],
  // Persist Claude Code state and shell history across rebuilds. ${devcontainerId}
  // is stable per workspace, so the same volumes are re-attached.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    // Set INIT_FIREWALL=true on the host to enable the egress firewall. Defaults to false.
    "INIT_FIREWALL": "${localEnv:INIT_FIREWALL:false}",
    // Claude Code's global config lives at ${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
    // (account binding, trust flags). At the default it sits outside the volume above,
    // so a rebuild forced a fresh login. Pointing at the mounted ~/.claude moves it --
    // plus projects/, sessions/, history -- inside, with no other layout change.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "latest",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh ${containerWorkspaceFolder}",
  // Script and allowlist are baked into the image (see Dockerfile), so this always runs
  // our version and workspace edits need a rebuild. INIT_FIREWALL only gates execution.
  "postStartCommand": "if [ \"$INIT_FIREWALL\" = true ]; then sudo /usr/local/bin/devcontainer-init-firewall.sh; else echo 'INIT_FIREWALL=false: skipping egress firewall setup'; fi",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "wenbopan.vscode-terminal-osc-notifier"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "security.workspace.trust.enabled": false
      }
    }
  }
}