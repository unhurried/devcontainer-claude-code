# Copy to .devcontainer/.env (gitignored). Takes effect on container rebuild.

# allowlist (default) - only the hosts in proxy/allowed-domains.txt.
# open                - any host. dev still has no route out except via squid.
#PROXY_MODE=open

# Host PulseAudio socket for /voice. Unset = /voice unavailable.
# WSL2: /mnt/wslg/PulseServer
#VOICE_PULSE_SOCKET=

# Host directories to bind-mount at /workspaces/mnt/<basename>. Entries are separated
# by ";"; append ":ro" to mount one read-only. Absolute paths to existing directories;
# basenames must be unique. Unset = nothing mounted. See README, Host directories.
#HOST_MOUNTS="/mnt/c/Users/me/Documents/notes:ro;/home/me/scratch"
