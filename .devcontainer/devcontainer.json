{
  "name": "devcontainer-claude-code-tmp",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "progress": "plain"
    }
  },
  "remoteUser": "vscode",
  "runArgs": [
    // Required by init-firewall.sh to manage iptables/ipset. Harmless no-op when
    // INIT_FIREWALL=false.
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  // Persist Claude Code session/auth state and shell history across rebuilds.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
  ],
  // Set INIT_FIREWALL=false on the host to disable the egress firewall. Defaults to true.
  "containerEnv": {
    "INIT_FIREWALL": "${localEnv:INIT_FIREWALL:true}"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "latest",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Runs once at container creation, after all features finish installing. Installs our
  // init-firewall.sh and allowed-domains.txt outside the workspace mount, so
  // postStartCommand (which runs on every start) always uses these versions — workspace
  // edits only take effect after a rebuild.
  "onCreateCommand": "if [ \"$INIT_FIREWALL\" = true ]; then sudo install -m 0755 ${containerWorkspaceFolder}/.devcontainer/scripts/init-firewall.sh /usr/local/bin/init-firewall.sh && sudo install -m 0644 ${containerWorkspaceFolder}/.devcontainer/scripts/allowed-domains.txt /usr/local/etc/allowed-domains.txt; else echo 'INIT_FIREWALL=false: leaving the feature-provided init-firewall.sh untouched and unused'; fi",
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh ${containerWorkspaceFolder}",
  "postStartCommand": "if [ \"$INIT_FIREWALL\" = true ]; then sudo /usr/local/bin/init-firewall.sh; else echo 'INIT_FIREWALL=false: skipping egress firewall setup'; fi",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "wenbopan.vscode-terminal-osc-notifier"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "security.workspace.trust.enabled": false
      }
    }
  }
}