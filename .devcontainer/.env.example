# Template. Copy to .devcontainer/.env to change these values; that copy is gitignored,
# so your local settings never end up in a commit. Without it the defaults below apply.
#
# .env is auto-loaded by docker-compose.yml. Either value applies on recreate:
# "Dev Containers: Rebuild Container", or from the host
#   docker compose -f .devcontainer/docker-compose.yml up -d --force-recreate proxy dev

# PROXY_MODE
#   allowlist (default) - squid allows only proxy/allowed-domains.txt.
#   open                - squid allows any hostname. The network split is untouched:
#                         dev still has no route out except through squid.
PROXY_MODE=allowlist

# VOICE_PULSE_SOCKET
#   Host PulseAudio socket to bind-mount for Claude Code's /voice. Unset (default) mounts
#   /dev/null instead and /voice reports no recorder. On WSL2, WSLg provides one:
#     VOICE_PULSE_SOCKET=/mnt/wslg/PulseServer
#VOICE_PULSE_SOCKET=
