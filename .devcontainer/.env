# Read by docker-compose.yml (Compose auto-loads .env next to the compose file) and
# interpolated into both the proxy and dev services' environment as PROXY_MODE.
#
#   allowlist (default) - squid allows only the hostnames in proxy/allowed-domains.txt.
#   open                - squid allows any destination; the dev container still has no
#                         route out except through squid (the isolated/egress network
#                         split is untouched), so this loosens *which domains* are
#                         reachable, not the structural isolation itself.
#
# Takes effect on container/service recreate, not live -- after editing this, run
# "Dev Containers: Rebuild Container", or from the host:
#   docker compose -f .devcontainer/docker-compose.yml up -d --force-recreate proxy dev
PROXY_MODE=allowlist
