# Copy to .devcontainer/.env (gitignored) to override the defaults below.
# Changes apply on container recreate ("Dev Containers: Rebuild Container").

# allowlist (default) - squid allows only proxy/allowed-domains.txt.
# open                - squid allows any host. dev still has no route out except via squid.
#PROXY_MODE=open

# Host PulseAudio socket for Claude Code's /voice. Unset = no recorder.
# On WSL2: VOICE_PULSE_SOCKET=/mnt/wslg/PulseServer
#VOICE_PULSE_SOCKET=
