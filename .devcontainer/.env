# Auto-loaded by docker-compose.yml, passed to the proxy and dev services as PROXY_MODE.
#
#   allowlist (default) - squid allows only proxy/allowed-domains.txt.
#   open                - squid allows any destination. The network split is untouched:
#                         dev still has no route out except through squid.
#
# Applies on recreate: "Dev Containers: Rebuild Container", or from the host
#   docker compose -f .devcontainer/docker-compose.yml up -d --force-recreate proxy dev
PROXY_MODE=allowlist
